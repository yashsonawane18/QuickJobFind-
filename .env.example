# ==============================================================================
# QuickJob Platform - Environment Configuration Example
# Copy this file to .env and configure values before running in production
# ==============================================================================

# --- Backend Server Configuration (FastAPI) ---
PORT=5055
PYTHONUNBUFFERED=1
DATA_RETENTION_DAYS=15

# --- Authentication & Security ---
# Secret key used to sign JWT access tokens (generate a long random string in production)
JWT_SECRET=quickjob_production_jwt_secret_change_this_in_production_2025

# Initial administrator account (auto-created on first startup with 'admin' role & 'approved' status)
ADMIN_EMAIL=admin@quickjob.io
ADMIN_PASSWORD=SetSecurePasswordHere123!

# --- Frontend Client Configuration (Vite) ---
# Set to your backend URL when deployed (e.g. https://quickjob-api.onrender.com)
VITE_API_BASE_URL=http://localhost:5055
VITE_FEATURE_JOB_DISCOVERY=true
